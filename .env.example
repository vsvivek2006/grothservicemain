# Growth Service Frontend - Environment Configuration Template
# NOTE: Variables with VITE_ prefix are exposed to the client bundle.
# NEVER put private API secrets, database passwords, or private keys here.

# Canonical Production URL (Defaults to https://www.growthservice.in in src/config/business.ts)
VITE_SITE_URL=https://www.growthservice.in

# Google Analytics 4 Measurement ID (Optional override; configured in index.html)
VITE_GA_MEASUREMENT_ID=G-P50L6F04NE
